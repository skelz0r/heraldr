#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IOS_DIR="${PROJECT_DIR}/ios"
PROJECT_NAME="Heraldr"
SCHEME="Heraldr"
INSTALLER="${HOME}/.agents/skills/ios-device-install/scripts/install-ios-app"
DERIVED_DATA="${PROJECT_DIR}/build/ios-device-run"

if [[ -f "${PROJECT_DIR}/.env.local" ]]; then
    set -a
    source "${PROJECT_DIR}/.env.local"
    set +a
fi

DEVICE_UUID="${1:-${IOS_DEVICE_UUID:-}}"
if [ -z "$DEVICE_UUID" ]; then
    echo "Missing iPhone: pass its CoreDevice UUID as argument or set IOS_DEVICE_UUID in .env.local (xcrun devicectl list devices)"
    exit 1
fi

CURRENT_DEV_DIR=$(xcode-select -p 2>/dev/null || echo "")
if [[ "$CURRENT_DEV_DIR" == *"CommandLineTools"* ]]; then
    echo "Error: xcode-select points to Command Line Tools, run bin/setup-ios"
    exit 1
fi

echo "Using device: ${DEVICE_UUID}"
echo "Waiting for device to be ready..."

MAX_RETRIES=30
RETRY_COUNT=0

while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    DEVICE_STATUS=$(xcrun xctrace list devices 2>&1 | grep "${DEVICE_UUID}" || echo "")

    if echo "$DEVICE_STATUS" | grep -q "error:Device is busy"; then
        echo "Device busy, waiting... (${RETRY_COUNT}/${MAX_RETRIES})"
        sleep 2
        RETRY_COUNT=$((RETRY_COUNT + 1))
    else
        break
    fi
done

if [ $RETRY_COUNT -eq $MAX_RETRIES ]; then
    echo "Device still busy after ${MAX_RETRIES} retries: unlock the iPhone, reconnect it or close Xcode"
    exit 1
fi

"${PROJECT_DIR}/bin/generate-ios"

AUTHENTICATION_ARGS=()
if [ -n "${ASC_KEY_ID:-}" ]; then
    if [ -z "${ASC_KEY_ISSUER_ID:-}" ]; then
        echo "ASC_KEY_ID is set without ASC_KEY_ISSUER_ID"
        exit 1
    fi
    ASC_KEY_PATH="${ASC_KEY_PATH:-$HOME/.private_keys/AuthKey_${ASC_KEY_ID}.p8}"
    if [ ! -f "$ASC_KEY_PATH" ]; then
        echo "App Store Connect key not found: ${ASC_KEY_PATH}"
        exit 1
    fi
    AUTHENTICATION_ARGS=(
        -authenticationKeyPath "$ASC_KEY_PATH"
        -authenticationKeyID "$ASC_KEY_ID"
        -authenticationKeyIssuerID "$ASC_KEY_ISSUER_ID"
    )
fi

echo "Building for device..."

if ! "${HOME}/dotfiles/bin/with-ci-keychain" xcodebuild \
    -project "${IOS_DIR}/${PROJECT_NAME}.xcodeproj" \
    -scheme "${SCHEME}" \
    -destination "generic/platform=iOS" \
    -configuration Debug \
    -derivedDataPath "${DERIVED_DATA}" \
    -allowProvisioningUpdates \
    "${AUTHENTICATION_ARGS[@]}" \
    build; then
    echo "Build failed (see xcodebuild output above)"
    exit 1
fi

APP_BUNDLE="${DERIVED_DATA}/Build/Products/Debug-iphoneos/${PROJECT_NAME}.app"

if [ ! -d "$APP_BUNDLE" ]; then
    echo "Could not find built app bundle ${APP_BUNDLE}"
    exit 1
fi

if [ -x "$INSTALLER" ]; then
    "$INSTALLER" --device "${DEVICE_UUID}" "${APP_BUNDLE}"
else
    xcrun devicectl device install app --device "${DEVICE_UUID}" "${APP_BUNDLE}"
fi
