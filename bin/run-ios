#!/usr/bin/env bash
set -e

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IOS_DIR="${PROJECT_DIR}/ios"
PROJECT_NAME="Compagnon"
SCHEME="Compagnon"
DERIVED_DATA="${PROJECT_DIR}/build/ios-run"
SIMULATOR="${1:-iPhone 17 Pro}"

CURRENT_DEV_DIR=$(xcode-select -p 2>/dev/null || echo "")
if [[ "$CURRENT_DEV_DIR" == *"CommandLineTools"* ]]; then
    echo "Error: xcode-select points to Command Line Tools, run bin/setup-ios"
    exit 1
fi

"${PROJECT_DIR}/bin/generate-ios"

echo "Building for ${SIMULATOR}..."

set +e
BUILD_OUTPUT=$(xcodebuild \
    -project "${IOS_DIR}/${PROJECT_NAME}.xcodeproj" \
    -scheme "${SCHEME}" \
    -destination "platform=iOS Simulator,name=${SIMULATOR}" \
    -configuration Debug \
    -derivedDataPath "${DERIVED_DATA}" \
    build 2>&1)
BUILD_STATUS=$?
set -e

echo "$BUILD_OUTPUT" | grep -E "(BUILD|error:|\*\*)" || true

if [ $BUILD_STATUS -ne 0 ] || ! echo "$BUILD_OUTPUT" | grep -q "BUILD SUCCEEDED"; then
    echo ""
    echo "Build failed"
    echo "List simulators: xcrun simctl list devices available"
    exit 1
fi

SIMULATOR_UUID=$(xcrun simctl list devices available | grep "    ${SIMULATOR} (" | head -1 | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}')

if [ -z "$SIMULATOR_UUID" ]; then
    echo "Could not find simulator ${SIMULATOR}"
    exit 1
fi

xcrun simctl boot "$SIMULATOR_UUID" 2>/dev/null || true
open -a Simulator

APP_BUNDLE="${DERIVED_DATA}/Build/Products/Debug-iphonesimulator/${PROJECT_NAME}.app"
BUNDLE_ID=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "${APP_BUNDLE}/Info.plist")

echo "Installing ${BUNDLE_ID}..."
xcrun simctl install "$SIMULATOR_UUID" "$APP_BUNDLE"
xcrun simctl launch "$SIMULATOR_UUID" "$BUNDLE_ID"

echo "App launched on ${SIMULATOR}"
