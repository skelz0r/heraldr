#!/usr/bin/env bash
set -uo pipefail

cd "${CLAUDE_PROJECT_DIR:-$(dirname "$0")/../..}" || exit 0
file="$(plutil -extract tool_input.file_path raw -o - - 2>/dev/null)" || exit 0
[ -f "$file" ] || exit 0
file="${file#"$PWD"/}"

failed=false
case "$file" in
    ios/Heraldr/*.swift | ios/HeraldrTests/*.swift | ios/HeraldrUITests/*.swift)
        output="$(xcrun swift-format lint --strict "$file" 2>&1 && swiftlint lint --strict --quiet "$file" 2>&1)" || failed=true ;;
    mac/*.mjs)
        output="$(biome check --error-on-warnings "$file" 2>&1)" || failed=true ;;
    bin/* | mac/dispatch.sh | mac/test/fake-herdr | mac/test/*.sh | .claude/hooks/*)
        output="$(shellcheck "$file" 2>&1)" || failed=true ;;
    *)
        exit 0 ;;
esac

if [ "$failed" = true ]; then
    printf 'Lint of %s failed, fix it now (exceptions only in .swiftlint.yml, .shellcheckrc or biome.json):\n%s\n' "$file" "$output" >&2
    exit 2
fi
